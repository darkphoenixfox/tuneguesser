{
  "name": "tuneguesser",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:server": "npm run dev -w @tuneguesser/server",
    "dev:web": "npm run dev -w @tuneguesser/web",
    "deploy:nas": "node tools/deploy-nas.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
